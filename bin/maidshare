#!/usr/bin/env bash
# MaidShare: send files/links from Linux to your Android phone.
# Backends (auto-picked in order, override with --via):
#   kdeconnect  paired phone on LAN (files + URLs)      [default]
#   adb         ADB push to /sdcard/Download (files)
#   http        throwaway LAN server + QR, zero phone setup (files)
# Usage: maidshare [--via kdeconnect|adb|http] [--device ID] [--adb TARGET] [FILE|URL]...
#        maidshare --receive [--time MIN]   (phone -> PC via browser upload)
set -u
BINDIR="$(cd "$(dirname "$0")" && pwd)"

usage() {
  echo "usage: maidshare [--via kdeconnect|adb|http] [--device ID] [--adb TARGET] [FILE|URL]..." >&2
  echo "       maidshare --receive [--time MIN]" >&2
}

VIA=""; NO_TUI=0; WANT_GUI=0
while [ $# -gt 0 ]; do
  case "${1:-}" in
    --via) VIA="${2:-}"; [ -n "$VIA" ] || { usage; exit 2; }; shift 2 ;;
    --device) MAID_DEVICE="${2:-}"; [ -n "$MAID_DEVICE" ] || { usage; exit 2; }; shift 2; export MAID_DEVICE ;;
    --adb) MAID_ADB="${2:-}"; [ -n "$MAID_ADB" ] || { usage; exit 2; }; shift 2; export MAID_ADB ;;
    --no-tui|--cli) NO_TUI=1; shift ;;
    --gui) WANT_GUI=1; shift ;;
    --help|-h) usage; exit 0 ;;
    --receive|*) break ;;
  esac
done
[ "$WANT_GUI" = "1" ] && { exec "$BINDIR/maidshare-gui" "$@"; }

popup() {
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "MaidShare" --passivepopup "$1" 8
  elif command -v zenity >/dev/null 2>&1; then
    zenity --notification --text="MaidShare: $1" 2>/dev/null || true
  else
    echo "MaidShare: $1"
  fi
}

sorry() {
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "MaidShare" --sorry "$1"
  elif command -v zenity >/dev/null 2>&1; then
    zenity --error --title="MaidShare" --text="$1" 2>/dev/null || true
  else
    echo "MaidShare ERROR: $1" >&2
  fi
}

firewall_hint() {
  # tell the user how to open $1/tcp instead of failing silently later
  if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
    firewall-cmd --query-port="$1/tcp" >/dev/null 2>&1 || \
      echo "MaidShare: phone can't reach TCP $1? run: sudo firewall-cmd --add-port=$1/tcp (runtime only, gone on reboot - add --permanent to keep it)"
  elif command -v ufw >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
    sudo -n ufw status 2>/dev/null | grep -qw "$1/tcp" || \
      echo "MaidShare: phone can't reach TCP $1? run: sudo ufw allow $1/tcp"
  fi
}

do_receive() {
  # phone -> PC: browser upload form behind a per-run token URL, over
  # TLS with a throwaway per-run cert (TOFU: compare the printed
  # fingerprint with the browser's certificate warning).
  local mins="${SERVE_MIN:-10}" port="${MAID_HTTP_PORT:-8078}"
  if [ "${1:-}" = "--time" ]; then mins="${2:-10}"; shift 2 || true; fi
  command -v python3 >/dev/null 2>&1 || { sorry "Need python3 for receive mode."; return 1; }
  local outdir="${XDG_DOWNLOAD_DIR:-$HOME/Downloads}/MaidShare"
  mkdir -p "$outdir"
  local token lan url fp certdir before after rc
  # shellcheck disable=SC1090
  . "$BINDIR/maid-cert.sh"
  certdir=$(mktemp -d -t maidshare-cert-XXXXXX) || { sorry "No temp dir. Is /tmp writable?"; return 1; }
  trap 'rm -rf "$certdir"' EXIT INT TERM
  fp=$(maid_cert "$certdir") || { rm -rf "$certdir"; trap - EXIT INT TERM; sorry "Need the openssl CLI for the encrypted link."; return 1; }
  token=$(python3 -c "import secrets; print(secrets.token_urlsafe(16))")
  lan=$(ip route get 1.1.1.1 2>/dev/null | grep -oP "src \K[0-9.]+" | head -n 1)
  if [ -z "$lan" ]; then rm -rf "$certdir"; trap - EXIT INT TERM; sorry "No LAN address found. Are you offline?"; return 1; fi
  url="https://$lan:$port/$token"
  firewall_hint "$port" &
  if command -v qrencode >/dev/null 2>&1; then
    qrencode -t ANSIUTF8 "$url" 2>/dev/null || true
  fi
  popup "Receive mode: scan/open on phone (valid ${mins} min):\n$url"
  echo "MaidShare receive at $url -> $outdir (${mins} min, Ctrl-C stops)"
  echo "cert fingerprint (compare with the browser warning): $fp"
  before=$(ls -A "$outdir" 2>/dev/null | sort | md5sum | awk '{print $1}')
  rc=0
  python3 "$BINDIR/maidshare-receive.py" "$port" "$outdir" "$token" "$mins" "$certdir/cert.pem" "$certdir/key.pem" || rc=$?
  rm -rf "$certdir"
  trap - EXIT INT TERM
  # 128+ is a signalled stop (Ctrl-C), not a server failure
  if [ "$rc" -ne 0 ] && [ "$rc" -lt 128 ]; then
    sorry "Receive server failed (exit $rc) - see the output above."
    return 1
  fi
  after=$(ls -A "$outdir" 2>/dev/null | sort | md5sum | awk '{print $1}')
  if [ "$before" != "$after" ]; then
    popup "Received files are in $outdir"
  fi
}

if [ "${1:-}" = "--receive" ]; then shift; do_receive "$@"; exit $?; fi

# --- Maidshare TUI (arrow + number, consistent style) ---
_ms_tty_restore() { stty "${_MS_TTY:-}" 2>/dev/null </dev/tty || true; printf '\033[?25h'; }
maidshare_boot() {
  [ -t 1 ] || return 0
  case "${TERM:-}" in ""|linux) return 0 ;; esac
  [ -z "${NO_COLOR:-}" ] || return 0
  [ "${MAID_FAST:-0}" = "1" ] && return 0
  local sz r c; sz="$(stty size 2>/dev/null </dev/tty)" || sz="$(stty size 2>/dev/null)" || sz="24 80"; r="${sz%% *}"; c="${sz##* }"
  [ "${r:-0}" -ge 1 ] 2>/dev/null || r=24; [ "${c:-0}" -ge 1 ] 2>/dev/null || c=80
  [ "$r" -ge 8 ] || r=24; [ "$c" -ge 34 ] || c=80
  local -a letters=(M A I D W A R E) rots=('|' '╱' '─' '╲') pal=("\033[94m" "\033[96m" "\033[92m" "\033[93m" "\033[95m")
  local n=${#letters[@]} slot=3 pad=$(((c-n*slot)/2)); [ "$pad" -ge 0 ] || pad=0
  local -a reveal=(); local i; for ((i=0;i<n;i++)); do reveal[i]=$((2+i)); done
  local total=$((reveal[n-1]+2)) wordrow=$((r/2-2)) f col glyph startcol
  printf '\033[?25l\033[0m'; trap 'printf "\033[?25h\033[0m"' INT TERM
  for ((f=0; f<total; f++)); do
    printf '\033[%d;1H\033[2K' "$wordrow"
    for ((i=0;i<n;i++)); do col=$((pad+i*slot+1))
      if [ "$f" -ge "${reveal[i]}" ]; then glyph="${pal[$(((f+n-i)%${#pal[@]}))]}"; printf '\033[%d;%dH%s%s\033[0m' "$wordrow" "$col" "$glyph" "${letters[i]}"
      elif [ "$f" -lt $((reveal[i]-2)) ]; then [ "$f" -gt 0 ] && printf '\033[%d;%dH\033[2m%s\033[0m' "$wordrow" "$col" "${rots[$(((f+i)%${#rots[@]}))]}"
      else startcol=1; [ $((i%2)) -eq 0 ] || startcol=$c; [ "$f" -eq $((reveal[i]-2)) ] && col=$startcol || col=$(((col+startcol)/2)); glyph="${pal[$(((f+i)%${#pal[@]}))]}"; printf '\033[%d;%dH%s%s\033[0m' "$wordrow" "$col" "$glyph" "${letters[i]}"; fi
    done
    local k=""; read -t 0.08 -n 1 -s k 2>/dev/null || true
    [ -n "${k:-}" ] && [ "$k" != $'\004' ] && [ "$k" != $'\000' ] && break
  done
  local word=""; for ((i=0;i<n;i++)); do word="$word ${letters[i]} "; done
  printf '\033[%d;1H\033[2K%*s\033[1;97m%s\033[0m' "$wordrow" "$pad" '' "$word"
  printf '\033[%d;1H\033[2K%*s\033[2mMaidshare - send / receive with your phone\033[0m' "$((wordrow+1))" "$(((c-42)/2))" ''
  sleep 0.45; trap - INT TERM; printf '\033[?25h\033[0m\033[2J\033[H'
}

ms_run_suite_installer() { # args...
  local url="https://raw.githubusercontent.com/Maidware-Project/Maidshare/main/install.sh"
  echo "==> Maidshare installer (official): $url"
  command -v curl >/dev/null 2>&1 || { echo "!! curl not found" >&2; return 1; }
  local tmp; tmp="$(mktemp /tmp/maidshare-inst.XXXXXX.sh)" || return 1
  if curl -fsSL "$url" -o "$tmp"; then bash "$tmp" "$@"; local rc=$?; rm -f "$tmp"; return "$rc"
  else echo "!! fetch failed" >&2; rm -f "$tmp"; return 1; fi
}

maidshare_tui() {
  maidshare_boot
  local -a labels=("Send file(s) to phone (picker)" "Receive from phone (QR/browser)" "Open Maidshare GUI" "Update from GitHub (latest)" "Reinstall" "Uninstall" "Quit")
  local n=${#labels[@]} cur=1 typed="" k seq i B=$'\e[1m' D=$'\e[2m' R=$'\e[0m' CY=$'\e[96m'
  while :; do
    printf '\033[H\033[2J%bMaidshare%b %b(send / receive — TUI)%b\n' "$B" "$R" "$D" "$R"
    printf '%*s\n' "${COLUMNS:-80}" '' | tr ' ' '-'
    printf '  %b↑↓/arrows or number · Enter select · q quit%b\n\n' "$D" "$R"
    if [ ! -t 0 ] || [ ! -t 1 ]; then printf '  > '; read -r cur || cur=7; [ "$cur" = "q" ] && cur=7; fi
    if [ -t 0 ] && [ -t 1 ]; then
      _MS_TTY=$(stty -g 2>/dev/null </dev/tty || true); trap '_ms_tty_restore' INT TERM
      stty -echo -icanon min 1 time 0 2>/dev/null </dev/tty || true; printf '\033[?25l\n\033[s'
      while :; do
        printf '\033[u\033[J'; i=1
        for it in "${labels[@]}"; do
          if [ "$i" -eq "$cur" ]; then printf '  %b❯ %s%b\033[K\n' "$CY$B" "$it" "$R"; else printf '    %b%s%b\033[K\n' "$D" "$it" "$R"; fi
          i=$((i+1))
        done
        printf '  %b>%b %s\033[K' "$B" "$R" "$typed"
        IFS= read -rsn1 k </dev/tty 2>/dev/null || k=""
        case "$k" in
          $'\x1b') IFS= read -rsn2 -t 0.08 seq </dev/tty 2>/dev/null || seq=""; case "$seq" in '[A'|'OA') [ "$cur" -gt 1 ] && cur=$((cur-1)); typed="" ;; '[B'|'OB') [ "$cur" -lt "$n" ] && cur=$((cur+1)); typed="" ;; esac ;;
          ""|$'\n'|$'\r') if [[ "${typed:-}" =~ ^[0-9]+$ ]] && [ "$typed" -ge 1 ] && [ "$typed" -le "$n" ]; then cur="$typed"; fi; _ms_tty_restore; trap - INT TERM; printf '\n'; break ;;
          q|Q) _ms_tty_restore; trap - INT TERM; printf '\n'; cur=7; break ;;
          [1-7]) typed="$k"; cur="$k" ;;
          $'\x7f'|$'\b') typed="" ;;
        esac
      done
    fi
    case "$cur" in
      1) picked="$(pick_file 2>/dev/null)" || picked=""; if [ -n "$picked" ]; then echo; "$0" --no-tui "$picked" || true; fi; printf '\n[Enter] menu '; read -r _ || true ;;
      2) echo; do_receive || true; printf '\n[Enter] menu '; read -r _ || true ;;
      3) echo; if command -v maidshare-gui >/dev/null 2>&1 || [ -x "$BINDIR/maidshare-gui" ]; then (maidshare-gui >/dev/null 2>&1 &); echo "Launched Maidshare GUI."; else echo "Maidshare GUI not found (install PyQt6 + reinstall Maidshare)."; fi; printf '\n[Enter] menu '; read -r _ || true ;;
      4) echo; ms_run_suite_installer || true; printf '\n[Enter] menu '; read -r _ || true ;;
      5) echo; ms_run_suite_installer || true; printf '\n[Enter] menu '; read -r _ || true ;;
      6) echo; printf 'Uninstall Maidshare? [y/N]: '; read -r _u || _u=""; case "${_u}" in y|Y*) ms_run_suite_installer --uninstall || true ;; *) echo "cancelled";; esac; printf '\n[Enter] menu '; read -r _ || true ;;
      7|q) echo "bye!"; exit 0 ;;
    esac
    cur=1; typed=""
  done
}

if [ $# -eq 0 ] && [ "$NO_TUI" != "1" ] && [ -t 0 ] && [ -t 1 ]; then maidshare_tui; exit $?; fi

pick_file() {
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "MaidShare" --getopenfilename "$HOME" 2>/dev/null
  elif command -v zenity >/dev/null 2>&1; then
    zenity --file-selection --title="MaidShare" 2>/dev/null
  else
    sorry "Need a file picker (kdialog or zenity) or pass a FILE argument."
    return 1
  fi
}

if [ $# -eq 0 ]; then
  picked="$(pick_file)" || exit 0
  [ -z "$picked" ] && exit 0
  set -- "$picked"
fi

pick_backend() {
  # echo first available backend from $2 for $1 (no side effects), else fail
  local file="$1" cands="$2" b mod
  for b in $cands; do
    mod="$BINDIR/backends/backend-$b.sh"
    [ -f "$mod" ] || continue
    # shellcheck disable=SC1090
    . "$mod"
    if backend_available; then echo "$b"; return 0; fi
  done
  return 1
}

send_one() {
  # $1 backend, $2 file. Safe in background jobs (subshell-safe).
  local b="$1" FILE="$2"
  # shellcheck disable=SC1090
  . "$BINDIR/backends/backend-$b.sh"
  backend_send "$FILE"
}

candidates_for() {
  # echo candidate backends for one file
  if [ -n "$VIA" ]; then echo "$VIA"; return; fi
  case "$1" in
    http://*|https://*) echo "kdeconnect" ;;
    *) echo "kdeconnect adb http" ;;
  esac
}

FAILED=0
httpfiles=()
# parallel arrays, not a joined string: filenames may contain "|"
par_backends=()
par_files=()
for FILE in "$@"; do
  case "$FILE" in
    http://*|https://*) : ;;
    *) [ -e "$FILE" ] || { sorry "File not found:\n$FILE"; FAILED=1; continue; } ;;
  esac
  if ! b=$(pick_backend "$FILE" "$(candidates_for "$FILE")"); then
    sorry "No usable backend for $(basename "$FILE"). Install KDE Connect, connect ADB, or ensure python3 + openssl exist."
    FAILED=1
    continue
  fi
  if [ "$b" = "http" ]; then
    httpfiles+=("$FILE")   # fixed port: served together, sequentially
  else
    par_backends+=("$b")   # independent sends run concurrently
    par_files+=("$FILE")
  fi
done

if [ "${#httpfiles[@]}" -gt 0 ]; then
  # shellcheck disable=SC1090
  . "$BINDIR/backends/backend-http.sh"
  if backend_send "${httpfiles[@]}"; then :; else FAILED=1; fi
fi

pids=""
for i in ${!par_backends[@]+"${!par_backends[@]}"}; do
  send_one "${par_backends[$i]}" "${par_files[$i]}" &
  pids="$pids $!"
done
for p in $pids; do wait "$p" || FAILED=1; done
[ "$FAILED" = "0" ] || exit 1
exit 0
